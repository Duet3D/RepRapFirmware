    "version": "0.2.0",
    "configurations": [
        {
            "name": "[Duet3_MB6HC] Build, Flash & Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Duet3_MB6HC/Duet3Firmware_MB6HC.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "miDebuggerServerAddress": "${input:gdb_server}",
            "launchCompleteCommand": "exec-continue",
            "stopAtEntry": false,
            "preLaunchTask": "Build Duet3_MB6HC - Debug",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "text": "monitor reset"
                },
                {
                    "text": "monitor halt"
                },
                {
                    "text": "load"
                },
                {
                    "text": "monitor reset"
                },
                {
                    "text": "monitor halt"
                }
            ]
        },
        {
            "name": "[Duet3_MB6HC] Debug Only",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Duet3_MB6HC/Duet3Firmware_MB6HC.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/../arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "miDebuggerServerAddress": "${input:gdb_server}",
            "launchCompleteCommand": "None",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
